{
  "name": "picocalc",
  "version": "0.0.4",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/picocalc/picocalc.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#src": "./src/index.ts",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "bench": "bun --cpu-prof-md --cpu-prof-dir ./bench/profiles bench/index.ts",
    "test": "bun test --dots",
    "lint": "oxlint",
    "format": "oxfmt",
    "build": "tsdown",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "bigint.bitlength": "0.2.0"
  },
  "devDependencies": {
    "@gameroman/config": "0.3.0",
    "@types/bun": "1.4.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsdown": "0.23.1",
    "typescript": "7.0.2"
  }
}
